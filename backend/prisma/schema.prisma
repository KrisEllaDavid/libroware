generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String         @id @default(uuid())
  email                  String         @unique
  password               String
  firstName              String
  lastName               String
  role                   Role           @default(USER)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?
  profilePicture         String?
  requiresPasswordChange Boolean?       @default(true)
  borrowedBooks          Borrow[]
  reviews                Review[]       @relation("UserReviews")
  fines                  Fine[]
  reservations           Reservation[]
  notifications          Notification[]

  @@index([role])
  @@index([deletedAt])
}

model Book {
  id           String        @id @default(uuid())
  title        String
  isbn         String        @unique
  description  String?
  publishedAt  DateTime
  coverImage   String?
  pageCount    Int
  quantity     Int           @default(1)
  available    Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  borrows      Borrow[]
  reviews      Review[]
  reservations Reservation[]
  authors      Author[]      @relation("BookToAuthor")
  categories   Category[]    @relation("BookToCategory")

  @@index([deletedAt])
}

model Author {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]   @relation("BookToAuthor")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]   @relation("BookToCategory")
}

model Borrow {
  id         String       @id @default(uuid())
  userId     String
  bookId     String
  borrowedAt DateTime     @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  status     BorrowStatus @default(BORROWED)
  note       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  book       Book         @relation(fields: [bookId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
  fine       Fine?

  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model Fine {
  id         String    @id @default(uuid())
  borrowId   String    @unique
  userId     String
  amount     Float
  dailyRate  Float
  daysOverdue Int
  waived     Boolean   @default(false)
  waivedBy   String?
  waivedAt   DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  borrow     Borrow    @relation(fields: [borrowId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([borrowId])
}

model Reservation {
  id        String            @id @default(uuid())
  userId    String
  bookId    String
  status    ReservationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  book      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  bookId    String
  userId    String
  userEmail String
  userName  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
}

enum Role {
  USER
  LIBRARIAN
  ADMIN
}

enum BorrowStatus {
  PENDING_APPROVAL
  BORROWED
  RETURNED
  OVERDUE
}

enum NotificationType {
  BORROW_REQUEST
  BORROW_APPROVED
  BORROW_REJECTED
  OVERDUE_REMINDER
  RESERVATION_READY
  FINE_ISSUED
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  data      Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(uuid())
  model     String
  action    String
  recordId  String
  userId    String?
  createdAt DateTime @default(now())

  @@index([model, recordId])
  @@index([userId])
}
