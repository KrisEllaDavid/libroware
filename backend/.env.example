# Database connection
DATABASE_URL="postgresql://username:password@localhost:5432/libroware_db"

# Server configuration
PORT=4000
NODE_ENV=development

# JWT Authentication — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET="replace-with-a-strong-random-secret"

# Set to true once HTTPS / TLS is configured (see SERVER_CONFIG.md §7)
# This adds the Secure flag to the httpOnly auth cookie.
COOKIE_SECURE=false

# Allowed CORS origins (comma-separated)
# Development
ALLOWED_ORIGINS="http://localhost:3000"
#
# Production (web + Electron desktop + Capacitor mobile):
# ALLOWED_ORIGINS="http://185.217.125.37:3030,libroware://localhost,capacitor://localhost,https://localhost"
# When your domain is ready, add it to the list above

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email notifications (optional — leave SMTP_HOST unset to disable)
# Works with any SMTP provider: Gmail (smtp.gmail.com:587), Brevo, SendGrid, etc.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Libroware <noreply@example.com>"
# Optional: override the default cron schedule (08:00 daily). Uses node-cron syntax.
# NOTIFICATION_CRON="0 8 * * *"