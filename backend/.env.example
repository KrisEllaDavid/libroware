# Database connection
DATABASE_URL="postgresql://username:password@localhost:5432/libroware_db"

# Server configuration
PORT=4000
NODE_ENV=development

# JWT Authentication — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET="replace-with-a-strong-random-secret"

# Allowed CORS origins (comma-separated)
# Development: the Vite dev server (port 3000)
# Production: replace with your actual deployed frontend URL
ALLOWED_ORIGINS="http://localhost:3000"

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"