{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "libroware",
  "version": "1.0.0",
  "description": "Library Management System — Congo-Cameroon Interstate University",
  "author": "KrisEllaDavid <ellakrisdavidsteeve@gmail.com>",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "apollo3-cache-persist": "^0.15.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.4.9",
    "graphql": "^16.11.0",
    "i18next": "^23.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.0.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.12.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --mode network --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:electron": "vite build --mode electron",
    "desktop:preview": "npm run build:electron && electron .",
    "desktop:win": "npm run build:electron && electron-builder --win nsis",
    "desktop:win:all": "npm run build:electron && electron-builder --win nsis msi",
    "desktop:linux": "npm run build:electron && electron-builder --linux deb AppImage",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "android:debug": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease",
    "ios:build": "npm run build && npx cap sync ios"
  },
  "build": {
    "appId": "com.libroware.app",
    "productName": "Libroware",
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/icon.png",
      "!**/node_modules/**"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Libroware",
      "installerIcon": "electron/icon.png",
      "uninstallerIcon": "electron/icon.png"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "electron/icon.png",
      "category": "Education"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.education"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^6.0.0",
    "@types/file-saver": "^2.0.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.0.0",
    "file-saver": "^2.0.5",
    "postcss": "^8.4.31",
    "vite": "^7.0.0"
  },
  "resolutions": {
    "@babel/plugin-transform-private-methods": "^7.22.5",
    "@babel/plugin-transform-class-properties": "^7.22.5",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.22.5",
    "@babel/plugin-transform-numeric-separator": "^7.22.5",
    "@babel/plugin-transform-optional-chaining": "^7.22.5",
    "@babel/plugin-transform-private-property-in-object": "^7.22.5",
    "@eslint/config-array": "^2.0.0",
    "@eslint/object-schema": "^2.0.0",
    "@jridgewell/sourcemap-codec": "^1.4.15",
    "@rollup/plugin-terser": "^0.4.4",
    "svgo": "^3.0.2",
    "lru-cache": "^10.0.1",
    "glob": "^10.3.3",
    "rimraf": "^5.0.1"
  }
}
